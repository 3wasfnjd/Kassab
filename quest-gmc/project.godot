; Kassab GMC AR — Meta Quest 3 passthrough app (Godot 4.6.3-stable, OpenXR Vendors 5.1.0-stable).
; The GMC (models/gmc.glb) drives on a patch of desert laid on your real floor. See README.md.

config_version=5

[application]

config/name="كساب GMC — AR"
config/description="A GMC pickup drifting and dune-bashing on your room floor (passthrough). By Aboden Games — عبودين قيمز."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="res://vr_splash.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray()

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[internationalization]

locale/include_text_server_data=true

[kassab]

store/meta_app_id=""

[physics]

common/physics_ticks_per_second=72
; (the truck runs its own fixed 180 Hz steps: scripts/truck.gd)

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/atlas_size=0
environment/defaults/default_clear_color=Color(0.86, 0.78, 0.66, 1)

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/environment_blend_mode=0
openxr/extensions/meta/passthrough=true
; room furniture (Space Setup) as obstacles for the truck
openxr/extensions/meta/scene_api=true
openxr/extensions/meta/anchor_api=true
openxr/foveation_level=2
openxr/foveation_dynamic=true
openxr/startup_alert=false
shaders/enabled=true
openxr/extensions/hand_tracking=false
